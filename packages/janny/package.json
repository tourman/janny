{
  "name": "janny",
  "version": "0.0.1",
  "keywords": [],
  "license": "MIT",
  "author": "tourman",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsup --onSuccess ./scripts/post-build",
    "dev": "pnpm build --watch",
    "lint": "pnpm eslint",
    "pipe:build": "pnpm build",
    "pipe:lint": "pnpm lint",
    "pipe:test": "CI=true jest --passWithNoTests",
    "pipe:tsc": "tsc -p tsconfig.json",
    "test": "jest --watch"
  },
  "jest": {
    "moduleDirectories": [
      "src",
      "src/utils",
      "node_modules"
    ],
    "moduleNameMapper": {
      "lodash-es": "lodash"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/js": "^9.22.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.30",
    "babel-jest": "^29.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "packageManager": "pnpm@10.6.1",
  "publishConfig": {
    "directory": "dist",
    "exports": {
      ".": {
        "import": "./index.mjs",
        "require": "./index.js",
        "types": "./index.d.ts"
      }
    },
    "main": "./index.mjs",
    "module": "./index.js",
    "types": "./index.d.ts"
  }
}
