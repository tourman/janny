{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["jest", "node"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "baseUrl": "src",
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
